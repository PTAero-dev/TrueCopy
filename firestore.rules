rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Single-owner application: TrueCopy (รับรองสำเนาถูกต้อง)
    // Ownership is isolated under /users/{uid} and restricted exclusively to
    // the verified single owner (taxicashflow@gmail.com, email_verified == true).
    // Note: /users/{uid} itself is only a namespace prefix; no parent /users/{uid}
    // document is created or directly accessed by the client.
    //
    // Collection: users/{uid}/signatures/{sigId}
    // Document ID: client-generated signature ID or Firestore auto-ID
    // Fields:
    //   - name: string (required, 1..100 chars) - display label
    //   - dataUrl: string (required, 1..600000 chars) - cleaned transparent PNG data URL
    //   - threshold: number (required, 0..255) - background removal threshold
    //   - tintSignature: bool (required) - recolor strokes to stamp color
    //   - createdAt: number (required, > 0, immutable on update) - epoch ms
    //   - rawDataUrl: string | null (optional, <= 600000 chars) - original image data URL
    //   - updatedAt: number (optional, >= 0) - epoch ms
    //
    // Collection: users/{uid}/templates/{templateId}
    // Document ID: client-generated template ID or Firestore auto-ID
    // Fields:
    //   - name: string (required, 1..120 chars)
    //   - purpose: string (required, <= 200 chars)
    //   - org: string (required, <= 200 chars)
    //   - templateLine: string (required, <= 400 chars)
    //   - certifyText: string (required, <= 200 chars)
    //   - showLines: bool (required)
    //   - lineStyle: string (required, 'dashed' | 'solid')
    //   - color: string (required, 1..20 chars)
    //   - font: string (required, 1..60 chars)
    //   - fontWeight: string (required, 1..10 chars)
    //   - fontSize: number (required, 8..100)
    //   - opacity: number (required, 0.05..1.0)
    //   - multiplyInk: bool (required)
    //   - stampScale: number (required, 0.1..2.0)
    //   - angle: number (required, -180..180)
    //   - posX: number (required, 0..1)
    //   - posY: number (required, 0..1)
    //   - flatten: bool (required)
    //   - showSignerName: bool (required)
    //   - signerName: string (required, <= 200 chars)
    //   - sigScale: number (required, 0.1..3.0)
    //   - tintSignature: bool (required)
    //   - createdAt: number (required, > 0, immutable on update) - epoch ms
    //   - updatedAt: number (optional, >= 0) - epoch ms
    //
    // Collection: users/{uid}/settings/{docId} (e.g., 'default')
    // Document ID: 'default' (or settings doc identifier)
    // Fields:
    //   - defaultTemplateId: string | null (optional, <= 128 chars)
    //   - defaultSignatureId: string | null (optional, <= 128 chars)
    //   - updatedAt: number (required, > 0) - epoch ms
    //
    // Collection: users/{uid}/history/{historyId} (Phase 3 ready)
    // Document ID: client-generated history ID or Firestore auto-ID
    // Fields:
    //   - createdAt: number (required, > 0, immutable on update) - epoch ms
    //   - fileNames: list<string> (required, size <= 100; first item checked <= 400 chars)
    //   - templateId: string | null (required, <= 128 chars if string)
    //   - purposeText: string (required, <= 400 chars)
    //   - pageCount: number (required, >= 1)
    //   - outputPath: string | null (optional, <= 400 chars)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user's UID matches the path UID
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Enforce single-owner isolation with verified email identity
    function isVerifiedOwner(uid) {
      return isOwner(uid) &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'taxicashflow@gmail.com' &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    // Validate all required fields exist on the resulting document
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate the resulting document contains only schema-defined fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate a string value is within [minLen, maxLen]
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate an optional field that may be omitted, null, or a bounded string
    function isValidOptionalStringOrNull(data, field, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate a numeric value is within [minVal, maxVal]
    function isNumberInRange(val, minVal, maxVal) {
      return val is number && val >= minVal && val <= maxVal;
    }

    // Validate a positive number (> 0)
    function isPositiveNumber(val) {
      return val is number && val > 0;
    }

    // Validate an optional non-negative number field
    function isValidOptionalNonNegativeNumber(data, field) {
      return !(field in data) ||
             (data[field] is number && data[field] >= 0);
    }

    // Ensure createdAt cannot be altered after document creation
    function isImmutableCreatedAt() {
      return !('createdAt' in resource.data) ||
             request.resource.data.createdAt == resource.data.createdAt;
    }

    // ===============================================================
    // Domain Validators (Called on BOTH create and update)
    // ===============================================================

    function isValidSignature(data) {
      let required = [
        'name', 'dataUrl', 'threshold', 'tintSignature', 'createdAt'
      ];
      let allowed = [
        'name', 'dataUrl', 'threshold', 'tintSignature', 'createdAt',
        'rawDataUrl', 'updatedAt'
      ];
      return hasRequiredFields(data, required) &&
             hasOnlyAllowedFields(data, allowed) &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.dataUrl, 1, 600000) &&
             isNumberInRange(data.threshold, 0, 255) &&
             data.tintSignature is bool &&
             isPositiveNumber(data.createdAt) &&
             isValidOptionalStringOrNull(data, 'rawDataUrl', 600000) &&
             isValidOptionalNonNegativeNumber(data, 'updatedAt');
    }

    function isValidTemplate(data) {
      let required = [
        'name', 'purpose', 'org', 'templateLine', 'certifyText',
        'showLines', 'lineStyle', 'color', 'font', 'fontWeight',
        'fontSize', 'opacity', 'multiplyInk', 'stampScale', 'angle',
        'posX', 'posY', 'flatten', 'showSignerName', 'signerName',
        'sigScale', 'tintSignature', 'createdAt'
      ];
      let allowed = [
        'name', 'purpose', 'org', 'templateLine', 'certifyText',
        'showLines', 'lineStyle', 'color', 'font', 'fontWeight',
        'fontSize', 'opacity', 'multiplyInk', 'stampScale', 'angle',
        'posX', 'posY', 'flatten', 'showSignerName', 'signerName',
        'sigScale', 'tintSignature', 'createdAt', 'updatedAt'
      ];
      return hasRequiredFields(data, required) &&
             hasOnlyAllowedFields(data, allowed) &&
             isValidString(data.name, 1, 120) &&
             isValidString(data.purpose, 0, 200) &&
             isValidString(data.org, 0, 200) &&
             isValidString(data.templateLine, 0, 400) &&
             isValidString(data.certifyText, 0, 200) &&
             data.showLines is bool &&
             data.lineStyle is string && data.lineStyle in ['dashed', 'solid'] &&
             isValidString(data.color, 1, 20) &&
             isValidString(data.font, 1, 60) &&
             isValidString(data.fontWeight, 1, 10) &&
             isNumberInRange(data.fontSize, 8, 100) &&
             isNumberInRange(data.opacity, 0.05, 1.0) &&
             data.multiplyInk is bool &&
             isNumberInRange(data.stampScale, 0.1, 2.0) &&
             isNumberInRange(data.angle, -180, 180) &&
             isNumberInRange(data.posX, 0, 1) &&
             isNumberInRange(data.posY, 0, 1) &&
             data.flatten is bool &&
             data.showSignerName is bool &&
             isValidString(data.signerName, 0, 200) &&
             isNumberInRange(data.sigScale, 0.1, 3.0) &&
             data.tintSignature is bool &&
             isPositiveNumber(data.createdAt) &&
             isValidOptionalNonNegativeNumber(data, 'updatedAt');
    }

    function isValidSettings(data) {
      let required = ['updatedAt'];
      let allowed = ['defaultTemplateId', 'defaultSignatureId', 'updatedAt'];
      return hasRequiredFields(data, required) &&
             hasOnlyAllowedFields(data, allowed) &&
             isPositiveNumber(data.updatedAt) &&
             isValidOptionalStringOrNull(data, 'defaultTemplateId', 128) &&
             isValidOptionalStringOrNull(data, 'defaultSignatureId', 128);
    }

    function isValidHistory(data) {
      let required = [
        'createdAt', 'fileNames', 'templateId', 'purposeText', 'pageCount'
      ];
      let allowed = [
        'createdAt', 'fileNames', 'templateId', 'purposeText', 'pageCount',
        'outputPath'
      ];
      return hasRequiredFields(data, required) &&
             hasOnlyAllowedFields(data, allowed) &&
             isPositiveNumber(data.createdAt) &&
             data.fileNames is list &&
             data.fileNames.size() <= 100 &&
             (data.fileNames.size() == 0 || isValidString(data.fileNames[0], 0, 400)) &&
             (data.templateId == null || isValidString(data.templateId, 0, 128)) &&
             isValidString(data.purposeText, 0, 400) &&
             data.pageCount is number && data.pageCount >= 1 &&
             isValidOptionalStringOrNull(data, 'outputPath', 400);
    }

    // ===============================================================
    // Collection Rules (Single-Owner Isolated)
    // ===============================================================

    match /users/{uid} {
      // Saved signature library
      match /signatures/{sigId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && isValidSignature(request.resource.data);
        allow update: if isVerifiedOwner(uid) && isValidSignature(request.resource.data) && isImmutableCreatedAt();
        allow delete: if isVerifiedOwner(uid);
      }

      // Saved stamp templates
      match /templates/{templateId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && isValidTemplate(request.resource.data);
        allow update: if isVerifiedOwner(uid) && isValidTemplate(request.resource.data) && isImmutableCreatedAt();
        allow delete: if isVerifiedOwner(uid);
      }

      // User preferences / default selections (e.g., settings/default)
      match /settings/{docId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && isValidSettings(request.resource.data);
        allow update: if isVerifiedOwner(uid) && isValidSettings(request.resource.data);
        allow delete: if isVerifiedOwner(uid);
      }

      // Certification audit history (Phase 3 ready)
      match /history/{historyId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && isValidHistory(request.resource.data);
        allow update: if isVerifiedOwner(uid) && isValidHistory(request.resource.data) && isImmutableCreatedAt();
        allow delete: if isVerifiedOwner(uid);
      }
    }

    // Default deny all other paths (including /users/{uid} itself)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
